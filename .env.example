# ValuiQ Backend — environment template.
# Copy to .env and fill in. NEVER commit the filled-in .env.
#
# Where a variable lists an "(or OLDNAME)" alternative, either name works — the first
# one listed wins if both are set. The newer names are what the deployment platforms
# are configured with; the older ones are kept so existing local .env files keep working.

# ── Server ─────────────────────────────────────────────────────────────────────
# Render injects PORT itself — do NOT set it there. Locally, blank means 5000.
PORT=
# Interface to bind. Leave blank: the default 0.0.0.0 is what container hosts need.
HOST=
NODE_ENV=development

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# (or MONGO_URI). Atlas > Connect > Drivers. Add the database name before the "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/valuiq?retryWrites=true&w=majority
# Optional tuning — blank uses the defaults in src/shared/config/env.js.
MONGO_SERVER_SELECTION_TIMEOUT_MS=
MONGO_SOCKET_TIMEOUT_MS=
MONGO_MAX_POOL_SIZE=
MONGO_CONNECT_RETRIES=
MONGO_CONNECT_RETRY_DELAY_MS=
# Optional: comma-separated public DNS (e.g. 8.8.8.8,1.1.1.1) if your network's
# default DNS refuses the Atlas mongodb+srv SRV lookup. Leave blank normally.
DNS_SERVERS=

# ── Frontend origin (CORS allowlist + links inside emails) ─────────────────────
# (or CLIENT_URL). Single origin or comma-separated list. NO trailing slash.
# In production this must NOT contain localhost — the app refuses to boot if it does.
FRONTEND_URL=https://your-app.vercel.app

# ── JWT (login session) ────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Reset token (password-reset only) ──────────────────────────────────────────
# MUST be a different value from JWT_SECRET. Generate it separately.
RESET_TOKEN_SECRET=
RESET_TOKEN_EXPIRES_IN=15m
RESET_OTP_EXPIRY_MINUTES=10
OTP_EXPIRY_MINUTES=10

# ── Redis (BullMQ fairness timers + cross-instance pub/sub) ────────────────────
# OPTIONAL. Unset = no Redis: the app still boots and auto-neglect falls back to the
# database sweep (inevitable, just not punctual).
#
# Use the Upstash TCP endpoint (rediss://), NOT the REST URL. BullMQ's blocking
# commands and Socket.IO pub/sub both need a real socket, which the REST API cannot
# provide. Upstash console > your database > the redis-cli / ioredis connect tab.
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# ── Email: Resend (primary transport) ──────────────────────────────────────────
# resend.com > API Keys. The sending domain must be verified, otherwise Resend only
# delivers to your own account address.
RESEND_API_KEY=

# ── Email: SMTP (fallback, used when Resend is absent or fails) ────────────────
# (or EMAIL_HOST / EMAIL_PORT / EMAIL_USER / EMAIL_PASS / EMAIL_FROM)
# For Gmail: SMTP_PASS is a 16-character App Password, NOT the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ValuiQ <no-reply@valuiq.com>

# ── Fairness timer (Week 4 moderation) ─────────────────────────────────────────
# All optional — blank uses the defaults in src/shared/config/env.js.
FAIRNESS_DEFAULT_TIMER_SECONDS=
FAIRNESS_MAX_TIMER_SECONDS=
FAIRNESS_WARN_FRACTION=
FAIRNESS_SWEEP_INTERVAL_SECONDS=
FAIRNESS_WORKER_CONCURRENCY=

# ── Logging ────────────────────────────────────────────────────────────────────
# debug | info | warn | error. Blank = debug in dev, info in production.
LOG_LEVEL=

# ── Security ───────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ── Stripe (Week 5, not yet wired) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# ── Cloudinary ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Prestige partner integration ───────────────────────────────────────────────
PRESTIGE_API_URL=
PRESTIGE_API_KEY=
