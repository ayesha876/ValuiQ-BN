# Server
PORT=
NODE_ENV=

# MongoDB
MONGO_URI=
# Optional: comma-separated public DNS (e.g. 8.8.8.8,1.1.1.1) if your network's
# default DNS refuses the Atlas mongodb+srv SRV lookup. Leave blank normally.
DNS_SERVERS=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# Reset token (password-reset only) — use a DIFFERENT value than JWT_SECRET
RESET_TOKEN_SECRET=
RESET_TOKEN_EXPIRES_IN=15m
RESET_OTP_EXPIRY_MINUTES=10

# Redis (for BullMQ background jobs)
REDIS_URL=

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client
CLIENT_URL=

# Prestige Partner Integration
PRESTIGE_API_URL=
PRESTIGE_API_KEY=
